# ─── Moin_Julia Konfiguration ───────────────────────────────────────────────
# Kopieren nach .env und ausfüllen. Die .env wird NIE committet.
# Nach Änderungen: `moin-julia restart` (bzw. `docker compose up -d`).

# ── Discord (Pflicht) ── https://discord.com/developers/applications
# Bot-Token: Reiter „Bot“ → „Reset Token“
DISCORD_TOKEN=
# Application-ID: Reiter „General Information“
DISCORD_CLIENT_ID=
# Client-Secret: Reiter „OAuth2“ → „Reset Secret“
DISCORD_CLIENT_SECRET=

# ── Dashboard ──
# Port auf dem Host (Standard 3000)
DASHBOARD_PORT=3000
# Öffentliche Adresse des Dashboards OHNE Slash am Ende.
# Im Discord Developer Portal unter OAuth2 → Redirects eintragen: <DASHBOARD_URL>/api/auth/callback
DASHBOARD_URL=http://localhost:3000
# Nur für Tests/Screenshots: Login ohne Discord. Produktiv IMMER false.
DASHBOARD_DEMO=false

# ── Datenbank (Passwort wird vom Installer zufällig erzeugt) ──
POSTGRES_USER=moin
POSTGRES_PASSWORD=
POSTGRES_DB=moin_julia

# ── KI „Julia“ (optional, ab Modul 10) ── https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Live-Alerts (optional, ab Modul 7) ──
# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube Data API v3: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ── Logging ──
LOG_LEVEL=info
