# ─── Moin_Julia Konfiguration ───────────────────────────────────────────────
# Der Proxmox-Installer schreibt diese Datei selbst. Discord-Zugang und API-Schlüssel
# trägst du NICHT hier ein, sondern im Einrichtungs-Assistenten des Dashboards
# (sie landen verschlüsselt in der Datenbank und sind später unter „System“ änderbar).
# Nach Änderungen an dieser Datei: `moin-julia restart`.

# ── Dashboard ──
# Port auf dem Host (Standard 3000)
DASHBOARD_PORT=3000
# Vorschlag für die Adresse im Assistenten (leer = Adresse, über die du das Dashboard aufrufst)
DASHBOARD_URL=
# Nur für Tests/Screenshots: Login ohne Discord. Produktiv IMMER false.
DASHBOARD_DEMO=false

# ── Ersteinrichtung ──
# Code für den Einrichtungs-Assistenten (zeigt der Installer an; `moin-julia setup-code`)
SETUP_CODE=
# Schlüssel, mit dem Tokens und API-Schlüssel in der Datenbank verschlüsselt werden.
# Einmal erzeugen (openssl rand -hex 32) und NIE ändern – sonst sind gespeicherte Geheimnisse unlesbar.
SECRETS_KEY=

# ── Datenbank (Passwort wird vom Installer zufällig erzeugt) ──
POSTGRES_USER=moin
POSTGRES_PASSWORD=
POSTGRES_DB=moin_julia

# ── Optional: klassische Konfiguration ohne Assistent ──
# Wenn diese Werte gesetzt sind, gelten sie, solange im Dashboard nichts anderes gespeichert ist.
# DISCORD_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YOUTUBE_API_KEY=

# ── Logging ──
LOG_LEVEL=info
