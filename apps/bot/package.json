{
  "name": "@moin/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@discordjs/voice": "^0.19.2",
    "@moin/db": "workspace:*",
    "@moin/shared": "workspace:*",
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "14.27.0",
    "ioredis": "^6.0.0",
    "opusscript": "^0.0.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
