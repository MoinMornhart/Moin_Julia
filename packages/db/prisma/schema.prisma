generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Ein Discord-Server, auf dem der Bot ist (oder war).
model Guild {
  id         String   @id
  name       String
  icon       String?
  ownerId    String
  /// Sprache der Bot-Texte: "de" oder "en"
  locale     String   @default("de")
  /// Rollen, deren Mitglieder das Dashboard lesend sehen dürfen (Mod-Stufe)
  modRoleIds String[] @default([])
  botPresent Boolean  @default(true)
  /// Fortlaufende Fall-Nummer der Moderation (zuletzt vergebene)
  caseCounter Int     @default(0)
  /// Fortlaufende Ticket-Nummer (zuletzt vergebene)
  ticketCounter Int   @default(0)
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  modules GuildModule[]
  cases   ModCase[]
}

/// An/Aus-Zustand und Einstellungen eines Moduls pro Server.
model GuildModule {
  guildId   String
  moduleId  String
  enabled   Boolean
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  /// Discord-User-ID der letzten Änderung im Dashboard
  updatedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Dashboard-Login. Die Server-Liste wird beim Login von Discord geholt und hier zwischengespeichert.
model Session {
  id        String   @id
  userId    String
  username  String
  avatar    String?
  /// [{ id, name, icon, owner, permissions }]
  guilds    Json
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum ModCaseType {
  WARN
  TIMEOUT
  UNTIMEOUT
  KICK
  BAN
  UNBAN
}

/// Ein Moderations-Fall mit fortlaufender Nummer pro Server.
model ModCase {
  id           Int         @id @default(autoincrement())
  guildId      String
  number       Int
  type         ModCaseType
  userId       String
  userTag      String
  moderatorId  String
  moderatorTag String
  reason       String?
  /// Dauer bei Timeouts in Sekunden
  durationSec  Int?
  /// Verwarnungen zählen nur, solange sie aktiv sind (zurückgenommen = false)
  active       Boolean     @default(true)
  /// "command", "automod" oder "escalation"
  source       String      @default("command")
  /// Mod-Log-Nachricht, um sie bei Änderungen zu aktualisieren
  logMessageId String?
  createdAt    DateTime    @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, number])
  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

/// Instanz-weite Einstellungen aus dem Einrichtungs-Assistenten (Tokens, Schlüssel, URL).
/// Geheime Werte sind mit AES-256-GCM verschlüsselt (Schlüssel aus SECRETS_KEY bzw. POSTGRES_PASSWORD).
model AppSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Selbstbedienungs-Rollen: ein Panel mit Buttons oder Auswahlmenü (Modul Willkommen & Rollen)
model RolePanel {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  channelId String?
  /// Nachricht in Discord, nachdem das Panel gesendet wurde
  messageId String?
  /// { style, mode, template, roles[] } – siehe rolePanelSchema in @moin/shared
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Sicherung aller Modul-Einstellungen eines Servers (automatisch vor jedem Import, wiederherstellbar)
model ConfigBackup {
  id        String   @id @default(cuid())
  guildId   String
  /// z. B. „Vor Import von Vorlage ‚Der Moin Club‘“
  reason    String
  createdBy String
  /// Vorlage im Export-Format (inkl. Rollen-Panels)
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Vom PC hochgeladene Bilder (Embed-Bilder, Willkommensbild-Hintergrund …).
/// Liegen in der Datenbank, damit sie im Backup stecken und der Bot sie als Anhang senden kann –
/// das Dashboard muss dafür nicht öffentlich erreichbar sein.
model Upload {
  id        String   @id @default(cuid())
  guildId   String
  /// Original-Dateiname (nur zur Anzeige)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdBy String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Eigene Sprachkanäle („Join to Create“): welcher Kanal wem gehört.
/// Überlebt Bot-Neustarts, damit leere Kanäle danach trotzdem aufgeräumt werden.
model TempVoiceChannel {
  channelId String   @id
  guildId   String
  ownerId   String
  /// Erstell-Kanal, aus dem er entstanden ist
  hubId     String
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([guildId, ownerId])
}

/// Ticket-Panel (Nachricht mit Knöpfen/Menü zum Öffnen von Tickets)
model TicketPanel {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  channelId String?
  messageId String?
  /// ticketPanelSchema (Vorlage, Darstellung, Gründe mit Fragen)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Ein Ticket – offen oder geschlossen (mit Transcript)
model Ticket {
  id           String    @id @default(cuid())
  guildId      String
  number       Int
  channelId    String    @unique
  openerId     String
  openerTag    String
  panelId      String?
  reasonId     String
  reasonLabel  String
  /// Antworten aus dem Formular: [{ label, value }]
  answers      Json      @default("[]")
  claimedBy    String?
  /// open | closed
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  closedAt     DateTime?
  closedBy     String?
  closeReason  String?
  /// 1–5 Sterne
  rating       Int?
  /// HTML-Verlauf (beim Schließen erzeugt)
  transcript   String?

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, openerId, status])
}

/// Teams: ausgeschriebene Stelle (Bewerbungsseite)
model JobPosition {
  id        String   @id @default(cuid())
  guildId   String
  /// positionSchema (Titel, Beschreibung, Fragen, Rollen, Probezeit, Anforderungen)
  data      Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Teams: eingegangene Bewerbung
model Application {
  id             String    @id @default(cuid())
  guildId        String
  positionId     String
  positionTitle  String
  userId         String
  userTag        String
  userAvatar     String?
  /// [{ fieldId, label, value, files? }]
  answers        Json
  /// pending | accepted | rejected
  status         String    @default("pending")
  /// suitable | unsuitable | overqualified | backup
  tag            String?
  handlerId      String?
  handlerTag     String?
  /// [{ by, byTag, text, at }]
  notes          Json      @default("[]")
  /// { at, place, status: invited|accepted|declined }
  interview      Json?
  decisionReason String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([guildId, status, createdAt])
  @@index([guildId, userId, positionId])
}

/// Teams: laufende Probezeit nach Annahme
model Probation {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  userTag       String
  applicationId String
  positionTitle String
  startAt       DateTime  @default(now())
  endAt         DateTime
  /// running | passed | failed
  status        String    @default("running")
  remindedAt    DateTime?
  decidedBy     String?

  @@index([guildId, status])
}

/// Social Media: ein Twitch-/YouTube-/Kick-Kanal, der in einen Discord-Kanal meldet
model SocialFeed {
  id            String    @id @default(cuid())
  guildId       String
  platform      String
  /// Twitch-/Kick-Login (klein) bzw. YouTube-Kanal-ID
  channelKey    String
  /// feedSchema (Ziel-Kanal, Texte, Ping-Rollen, Live-Rolle …)
  data          Json
  /// feedStateSchema (gesehene Videos, laufender Stream) – schreibt nur der Bot
  state         Json      @default("{}")
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([guildId])
  @@index([platform, channelKey])
}

/// Level & XP: ein Eintrag pro Mitglied und Server
model MemberXp {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  userTag       String    @default("")
  avatar        String?
  xp            Int       @default(0)
  level         Int       @default(0)
  messages      Int       @default(0)
  voiceMinutes  Int       @default(0)
  lastXpAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}
