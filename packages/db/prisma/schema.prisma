generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Ein Discord-Server, auf dem der Bot ist (oder war).
model Guild {
  id         String   @id
  name       String
  icon       String?
  ownerId    String
  /// Sprache der Bot-Texte: "de" oder "en"
  locale     String   @default("de")
  /// Rollen, deren Mitglieder das Dashboard lesend sehen dürfen (Mod-Stufe)
  modRoleIds String[] @default([])
  botPresent Boolean  @default(true)
  /// Fortlaufende Fall-Nummer der Moderation (zuletzt vergebene)
  caseCounter Int     @default(0)
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  modules GuildModule[]
  cases   ModCase[]
}

/// An/Aus-Zustand und Einstellungen eines Moduls pro Server.
model GuildModule {
  guildId   String
  moduleId  String
  enabled   Boolean
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  /// Discord-User-ID der letzten Änderung im Dashboard
  updatedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Dashboard-Login. Die Server-Liste wird beim Login von Discord geholt und hier zwischengespeichert.
model Session {
  id        String   @id
  userId    String
  username  String
  avatar    String?
  /// [{ id, name, icon, owner, permissions }]
  guilds    Json
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum ModCaseType {
  WARN
  TIMEOUT
  UNTIMEOUT
  KICK
  BAN
  UNBAN
}

/// Ein Moderations-Fall mit fortlaufender Nummer pro Server.
model ModCase {
  id           Int         @id @default(autoincrement())
  guildId      String
  number       Int
  type         ModCaseType
  userId       String
  userTag      String
  moderatorId  String
  moderatorTag String
  reason       String?
  /// Dauer bei Timeouts in Sekunden
  durationSec  Int?
  /// Verwarnungen zählen nur, solange sie aktiv sind (zurückgenommen = false)
  active       Boolean     @default(true)
  /// "command", "automod" oder "escalation"
  source       String      @default("command")
  /// Mod-Log-Nachricht, um sie bei Änderungen zu aktualisieren
  logMessageId String?
  createdAt    DateTime    @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, number])
  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

/// Instanz-weite Einstellungen aus dem Einrichtungs-Assistenten (Tokens, Schlüssel, URL).
/// Geheime Werte sind mit AES-256-GCM verschlüsselt (Schlüssel aus SECRETS_KEY bzw. POSTGRES_PASSWORD).
model AppSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Selbstbedienungs-Rollen: ein Panel mit Buttons oder Auswahlmenü (Modul Willkommen & Rollen)
model RolePanel {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  channelId String?
  /// Nachricht in Discord, nachdem das Panel gesendet wurde
  messageId String?
  /// { style, mode, template, roles[] } – siehe rolePanelSchema in @moin/shared
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}
