generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Ein Discord-Server, auf dem der Bot ist (oder war).
model Guild {
  id         String   @id
  name       String
  icon       String?
  ownerId    String
  /// Sprache der Bot-Texte: "de" oder "en"
  locale     String   @default("de")
  /// Rollen, deren Mitglieder das Dashboard lesend sehen dürfen (Mod-Stufe)
  modRoleIds String[] @default([])
  botPresent Boolean  @default(true)
  /// Fortlaufende Fall-Nummer der Moderation (zuletzt vergebene)
  caseCounter Int     @default(0)
  /// Fortlaufende Ticket-Nummer (zuletzt vergebene)
  ticketCounter Int   @default(0)
  suggestionCounter Int @default(0)
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  modules GuildModule[]
  cases   ModCase[]
}

/// An/Aus-Zustand und Einstellungen eines Moduls pro Server.
model GuildModule {
  guildId   String
  moduleId  String
  enabled   Boolean
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  /// Discord-User-ID der letzten Änderung im Dashboard
  updatedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Dashboard-Login. Die Server-Liste wird beim Login von Discord geholt und hier zwischengespeichert.
model Session {
  id        String   @id
  userId    String
  username  String
  avatar    String?
  /// [{ id, name, icon, owner, permissions }]
  guilds    Json
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum ModCaseType {
  WARN
  TIMEOUT
  UNTIMEOUT
  KICK
  BAN
  UNBAN
}

/// Ein Moderations-Fall mit fortlaufender Nummer pro Server.
model ModCase {
  id           Int         @id @default(autoincrement())
  guildId      String
  number       Int
  type         ModCaseType
  userId       String
  userTag      String
  moderatorId  String
  moderatorTag String
  reason       String?
  /// Dauer bei Timeouts in Sekunden
  durationSec  Int?
  /// Verwarnungen zählen nur, solange sie aktiv sind (zurückgenommen = false)
  active       Boolean     @default(true)
  /// "command", "automod" oder "escalation"
  source       String      @default("command")
  /// Mod-Log-Nachricht, um sie bei Änderungen zu aktualisieren
  logMessageId String?
  createdAt    DateTime    @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, number])
  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

/// Instanz-weite Einstellungen aus dem Einrichtungs-Assistenten (Tokens, Schlüssel, URL).
/// Geheime Werte sind mit AES-256-GCM verschlüsselt (Schlüssel aus SECRETS_KEY bzw. POSTGRES_PASSWORD).
model AppSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Selbstbedienungs-Rollen: ein Panel mit Buttons oder Auswahlmenü (Modul Willkommen & Rollen)
model RolePanel {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  channelId String?
  /// Nachricht in Discord, nachdem das Panel gesendet wurde
  messageId String?
  /// { style, mode, template, roles[] } – siehe rolePanelSchema in @moin/shared
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Sicherung aller Modul-Einstellungen eines Servers (automatisch vor jedem Import, wiederherstellbar)
model ConfigBackup {
  id        String   @id @default(cuid())
  guildId   String
  /// z. B. „Vor Import von Vorlage ‚Der Moin Club‘“
  reason    String
  createdBy String
  /// Vorlage im Export-Format (inkl. Rollen-Panels)
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Vom PC hochgeladene Bilder (Embed-Bilder, Willkommensbild-Hintergrund …).
/// Liegen in der Datenbank, damit sie im Backup stecken und der Bot sie als Anhang senden kann –
/// das Dashboard muss dafür nicht öffentlich erreichbar sein.
model Upload {
  id        String   @id @default(cuid())
  guildId   String
  /// Original-Dateiname (nur zur Anzeige)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdBy String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Eigene Sprachkanäle („Join to Create“): welcher Kanal wem gehört.
/// Überlebt Bot-Neustarts, damit leere Kanäle danach trotzdem aufgeräumt werden.
model TempVoiceChannel {
  channelId String   @id
  guildId   String
  ownerId   String
  /// Erstell-Kanal, aus dem er entstanden ist
  hubId     String
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([guildId, ownerId])
}

/// Ticket-Panel (Nachricht mit Knöpfen/Menü zum Öffnen von Tickets)
model TicketPanel {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  channelId String?
  messageId String?
  /// ticketPanelSchema (Vorlage, Darstellung, Gründe mit Fragen)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Ein Ticket – offen oder geschlossen (mit Transcript)
model Ticket {
  id           String    @id @default(cuid())
  guildId      String
  number       Int
  channelId    String    @unique
  openerId     String
  openerTag    String
  panelId      String?
  reasonId     String
  reasonLabel  String
  /// Antworten aus dem Formular: [{ label, value }]
  answers      Json      @default("[]")
  claimedBy    String?
  /// open | closed
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  closedAt     DateTime?
  closedBy     String?
  closeReason  String?
  /// 1–5 Sterne
  rating       Int?
  /// HTML-Verlauf (beim Schließen erzeugt)
  transcript   String?

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, openerId, status])
}

/// Teams: ausgeschriebene Stelle (Bewerbungsseite)
model JobPosition {
  id        String   @id @default(cuid())
  guildId   String
  /// positionSchema (Titel, Beschreibung, Fragen, Rollen, Probezeit, Anforderungen)
  data      Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Teams: eingegangene Bewerbung
model Application {
  id             String    @id @default(cuid())
  guildId        String
  positionId     String
  positionTitle  String
  userId         String
  userTag        String
  userAvatar     String?
  /// [{ fieldId, label, value, files? }]
  answers        Json
  /// pending | accepted | rejected
  status         String    @default("pending")
  /// suitable | unsuitable | overqualified | backup
  tag            String?
  handlerId      String?
  handlerTag     String?
  /// [{ by, byTag, text, at }]
  notes          Json      @default("[]")
  /// { at, place, status: invited|accepted|declined }
  interview      Json?
  decisionReason String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([guildId, status, createdAt])
  @@index([guildId, userId, positionId])
}

/// Teams: laufende Probezeit nach Annahme
model Probation {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  userTag       String
  applicationId String
  positionTitle String
  startAt       DateTime  @default(now())
  endAt         DateTime
  /// running | passed | failed
  status        String    @default("running")
  remindedAt    DateTime?
  decidedBy     String?

  @@index([guildId, status])
}

/// Social Media: ein Twitch-/YouTube-/Kick-Kanal, der in einen Discord-Kanal meldet
model SocialFeed {
  id            String    @id @default(cuid())
  guildId       String
  platform      String
  /// Twitch-/Kick-Login (klein) bzw. YouTube-Kanal-ID
  channelKey    String
  /// feedSchema (Ziel-Kanal, Texte, Ping-Rollen, Live-Rolle …)
  data          Json
  /// feedStateSchema (gesehene Videos, laufender Stream) – schreibt nur der Bot
  state         Json      @default("{}")
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([guildId])
  @@index([platform, channelKey])
}

/// Level & XP: ein Eintrag pro Mitglied und Server
model MemberXp {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  userTag       String    @default("")
  avatar        String?
  xp            Int       @default(0)
  level         Int       @default(0)
  messages      Int       @default(0)
  voiceMinutes  Int       @default(0)
  lastXpAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

/// Community: Geburtstag pro Mitglied und Server (Jahr optional)
model Birthday {
  id           String    @id @default(cuid())
  guildId      String
  userId       String
  userTag      String    @default("")
  day          Int
  month        Int
  year         Int?
  /// Jahr, in dem zuletzt gratuliert wurde (gegen Doppel-Glückwünsche)
  lastWishedYear Int?
  /// Geburtstagsrolle gesetzt am (zum Entfernen am nächsten Tag)
  roleGivenAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([guildId, userId])
  @@index([guildId, month, day])
}

/// Community: Zähl-Kanal-Zustand
model CountingState {
  guildId    String   @id
  current    Int      @default(0)
  lastUserId String?
  record     Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Community: Vorschläge mit Abstimmung
model Suggestion {
  id         String    @id @default(cuid())
  guildId    String
  number     Int
  userId     String
  userTag    String
  text       String
  channelId  String
  messageId  String?
  /// Vorschlags-Bereich ("main" = Hauptbereich)
  boardId    String    @default("main")
  /// Nachricht im Team-Kanal mit den Entscheidungs-Knöpfen
  staffMessageId String?
  /// userId → 1 (dafür) / -1 (dagegen)
  votes      Json      @default("{}")
  status     String    @default("open")
  reason     String?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([guildId, number])
  @@index([guildId, status])
}

/// Community: Starboard – welche Nachricht steht schon im Starboard
model StarboardEntry {
  id                 String   @id @default(cuid())
  guildId            String
  messageId          String   @unique
  channelId          String
  starboardMessageId String?
  stars              Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([guildId])
}

/// Community: Giveaways (Teilnahme per Knopf)
model Giveaway {
  id             String    @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  prize          String
  winnerCount    Int       @default(1)
  requiredRoleId String?
  hostId         String
  entrants       Json      @default("[]")
  winnerIds      Json      @default("[]")
  endsAt         DateTime
  ended          Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([guildId, ended])
  @@index([ended, endsAt])
}

/// Community: Erinnerungen per DM
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  guildId   String?
  text      String
  dueAt     DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([done, dueAt])
  @@index([userId, done])
}

/// Julia: Verbrauch pro Server und Monat (Kosten in Mikro-Dollar)
model JuliaUsage {
  id           String   @id @default(cuid())
  guildId      String
  month        String
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheRead    Int      @default(0)
  cacheWrite   Int      @default(0)
  costMicroUsd Int      @default(0)
  /// Zuletzt gewarnt bei … Prozent (gegen doppelte Warnungen)
  warnedPercent Int     @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([guildId, month])
}

/// Julia: Profil pro Person und Server (Spitzname, Anrede, Gedächtnis, Opt-out, Flirt-Sperre)
model JuliaProfile {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  userTag      String   @default("")
  nickname     String?
  /// "du" | "sie" | null (egal)
  address      String?
  /// [{ text, at }] – höchstens MAX_FACTS
  facts        Json     @default("[]")
  /// Julia ignoriert diese Person komplett
  optOut       Boolean  @default(false)
  flirtyOptIn  Boolean  @default(false)
  /// Dauerhafte Flirt-Sperre nach Altersangabe unter 18 – lässt sich nur im Dashboard zurücksetzen
  underage     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
}

/// Julia: aktiver Modus pro Kanal (fehlt = Server-Standard)
model JuliaChannelMode {
  guildId   String
  channelId String
  modeId    String
  setBy     String
  updatedAt DateTime @updatedAt

  @@id([guildId, channelId])
}

/// Statistiken: Tageswerte pro Server
model GuildStatDay {
  guildId      String
  day          String
  joins        Int    @default(0)
  leaves       Int    @default(0)
  messages     Int    @default(0)
  voiceMinutes Int    @default(0)
  /// Mitgliederzahl am Ende des Tages (zuletzt gemessen)
  memberCount  Int    @default(0)

  @@id([guildId, day])
}

/// Statistiken: Nachrichten pro Kanal und Tag
model ChannelStatDay {
  guildId   String
  channelId String
  day       String
  messages  Int    @default(0)

  @@id([guildId, channelId, day])
  @@index([guildId, day])
}

/// Statistiken: Aktivität pro Mitglied und Tag
model MemberStatDay {
  guildId      String
  userId       String
  day          String
  userTag      String @default("")
  messages     Int    @default(0)
  voiceMinutes Int    @default(0)

  @@id([guildId, userId, day])
  @@index([guildId, day])
}

/// Owner-Bereich: ursprüngliche Rechte einer Rolle, bevor „Administrator“ ersetzt wurde (zum Rückgängigmachen)
model OwnerRoleBackup {
  id          String    @id @default(cuid())
  guildId     String
  roleId      String
  roleName    String
  /// Rechte als Bitfeld (Dezimal-String, BigInt)
  permissions String
  createdBy   String
  /// "applied" | "failed" | "restored"
  status      String    @default("applied")
  error       String?
  createdAt   DateTime  @default(now())
  restoredAt  DateTime?

  @@index([guildId])
}

/// Musik: Playlists pro Person und Server (auch „❤️ Lieblingssongs“)
model MusicPlaylist {
  id        String   @id @default(cuid())
  guildId   String
  ownerId   String
  name      String
  /// [{ title, url, kind, durationMs?, author? }]
  tracks    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, ownerId, name])
  @@index([guildId])
}
